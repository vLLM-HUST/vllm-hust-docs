{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-hust.sage.org.ai/schemas/repository-profile-v1.schema.json",
  "title": "vLLM-HUST repository-local ecosystem profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "canonical_registry", "repository", "repository_role",
    "relation_to_runtime", "lifecycle", "artifacts", "system_boundaries",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonical_registry": {
      "const": "https://github.com/vLLM-HUST/vllm-hust-docs/tree/codex/ecosystem-architecture-reorganization/registry"
    },
    "repository": {"type": "string", "format": "uri"},
    "repository_role": {
      "enum": [
        "runtime_core", "platform_profile", "sibling_runtime",
        "external_subsystem", "integration_provider", "runtime_component",
        "runtime_substrate", "benchmark_tool", "analysis_tool",
        "development_tool", "operations_tool", "documentation_source",
        "public_application", "organization_governance", "application",
        "research_publication", "sandbox", "archive"
      ]
    },
    "relation_to_runtime": {
      "enum": [
        "owns_core_contracts", "implements_core_contracts",
        "integrates_external_system", "provides_external_subsystem",
        "extends_runtime_behavior", "provides_runtime_substrate",
        "sibling_runtime", "supports_runtime_delivery",
        "produces_runtime_evidence", "documents_runtime",
        "presents_canonical_registry", "organization_wide",
        "adjacent_research", "historical_only"
      ]
    },
    "lifecycle": {
      "enum": [
        "core", "supported", "certified_external", "incubating",
        "community", "deprecated", "archived"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "artifact_type", "system_role", "delivery_model",
          "execution_planes", "integration_contracts"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "artifact_type": {
            "enum": [
              "runtime_core", "platform_profile", "runtime_component",
              "external_system", "bridge", "tool", "application"
            ]
          },
          "system_role": {
            "enum": [
              "inference_runtime", "platform_backend", "scheduler_policy",
              "decoding_mechanism", "operator_runtime", "kv_state_manager",
              "kv_store", "transport", "kv_integration", "control_plane",
              "control_plane_bridge", "compiler_kernel",
              "deployment_operations", "benchmark_evidence",
              "profiling_analysis", "documentation_catalog", "product_ui"
            ]
          },
          "delivery_model": {
            "enum": [
              "core_release", "platform_distribution", "plugin_bundle",
              "python_distribution", "native_distribution",
              "container_service", "external_service", "source_repository"
            ]
          },
          "execution_planes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "api", "scheduler", "worker", "native", "device", "bridge",
                "external_service", "cluster_control", "offline"
              ]
            },
            "uniqueItems": true
          },
          "integration_contracts": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "integration_surfaces": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "system_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is", "is_not"],
      "properties": {
        "is": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "is_not": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "compatibility_document": {"type": ["string", "null"]}
  }
}
