{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-hust.sage.org.ai/schemas/repository-profile-v1.schema.json",
  "title": "vLLM-HUST repository-local ecosystem profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "canonical_registry", "repository", "repository_role",
    "relation_to_runtime", "lifecycle", "artifacts", "system_boundaries",
    "validation"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonical_registry": {
      "const": "https://github.com/vLLM-HUST/vllm-hust-docs/tree/codex/ecosystem-architecture-reorganization/registry"
    },
    "repository": {"type": "string", "format": "uri"},
    "repository_role": {"type": "string", "minLength": 1},
    "relation_to_runtime": {"type": "string", "minLength": 1},
    "lifecycle": {
      "enum": [
        "core", "supported", "certified_external", "incubating",
        "community", "deprecated", "archived"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "artifact_type", "system_role", "delivery_model",
          "execution_planes", "integration_contracts"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "artifact_type": {"type": "string", "minLength": 1},
          "system_role": {"type": "string", "minLength": 1},
          "delivery_model": {"type": "string", "minLength": 1},
          "execution_planes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          },
          "integration_contracts": {
            "type": "array",
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "system_boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is", "is_not"],
      "properties": {
        "is": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "is_not": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "compatibility_document": {"type": ["string", "null"]}
  }
}
