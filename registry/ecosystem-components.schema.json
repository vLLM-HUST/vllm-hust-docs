{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vllm-hust.sage.org.ai/schemas/ecosystem-components-v1.schema.json",
  "title": "vLLM-HUST ecosystem component registry",
  "type": "object",
  "required": ["schema_version", "canonical_owner", "components"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonical_owner": {"const": "vLLM-HUST/vllm-hust-docs"},
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    }
  },
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "artifact_type", "system_role",
        "integration_contracts", "execution_planes", "deployment_topology",
        "delivery_model", "ownership", "maturity", "canonical_repository",
        "summary_en", "summary_zh", "evidence_level"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "artifact_type": {
          "enum": ["runtime_core", "platform_profile", "runtime_component", "external_system", "bridge", "tool", "application"]
        },
        "system_role": {
          "enum": ["inference_runtime", "platform_backend", "scheduler_policy", "decoding_mechanism", "operator_runtime", "kv_state_manager", "kv_store", "transport", "kv_integration", "control_plane", "control_plane_bridge", "compiler_kernel", "deployment_operations", "benchmark_evidence", "profiling_analysis", "documentation_catalog", "product_ui"]
        },
        "integration_contracts": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "integration_surfaces": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "execution_planes": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["api", "scheduler", "worker", "native", "device", "bridge", "external_service", "cluster_control", "offline"]},
          "uniqueItems": true
        },
        "deployment_topology": {
          "enum": ["built_in", "in_process", "sidecar", "daemon", "distributed_service", "separate_application", "mixed"]
        },
        "delivery_model": {
          "enum": ["core_release", "platform_distribution", "plugin_bundle", "python_distribution", "native_distribution", "container_service", "external_service", "source_repository"]
        },
        "ownership": {
          "enum": ["core_owned", "hust_owned_subsystem", "hust_maintained_external_integration", "certified_external_integration", "upstream_owned", "community_integration"]
        },
        "maturity": {
          "enum": ["concept", "incubating", "experimental", "supported", "verified", "deprecated", "archived"]
        },
        "canonical_repository": {"type": ["string", "null"], "format": "uri"},
        "upstream_repository": {"type": ["string", "null"], "format": "uri"},
        "summary_en": {"type": "string", "minLength": 1},
        "summary_zh": {"type": "string", "minLength": 1},
        "evidence_level": {
          "enum": ["descriptor_only", "cpu_smoke", "integration_tested", "hardware_verified", "performance_verified", "production_observed"]
        }
      }
    }
  }
}
